# Copy to .env for local development. Replace all placeholder values.
POSTGRES_DB=evidencechain
POSTGRES_USER=evidencechain
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/evidencechain
DB_USERNAME=evidencechain
DB_PASSWORD=replace-with-a-local-database-password

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Base64 encoding of at least 32 random bytes. Generate with:
# openssl rand -base64 32
JWT_SECRET_BASE64=replace-with-base64-encoded-random-bytes
JWT_EXPIRATION_SECONDS=3600
